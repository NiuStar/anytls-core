+++ b/session/connect_ack.go
@@ -0,0 +1,77 @@
+package session
+
+import (
+	"context"
+	"errors"
+	"os"
+	"time"
+)
+
+// ErrConnectACKUnsupported means the authenticated peer explicitly advertised v1.
+// A silent peer cannot be distinguished from delayed negotiation.
+var ErrConnectACKUnsupported = errors.New("anytls: peer does not support CONNECT ACK")
+var ErrConnectACKUnconfirmed = errors.New("anytls: CONNECT ACK capability unconfirmed")
+
+// RemoteConnectError is safe to format. Unwrap exposes the original peer error,
+// which may contain sensitive untrusted text and must not be logged verbatim.
+type RemoteConnectError struct{ Cause error }
+
+func (*RemoteConnectError) Error() string   { return "anytls: remote CONNECT failed" }
+func (e *RemoteConnectError) Unwrap() error { return e.Cause }
+
+func (s *Stream) completeConnect(err error) {
+	s.connectOnce.Do(func() { s.connectErr = err; close(s.connectDone) })
+}
+
+// classifyConnectExit is the return-point policy for every waiter exit.
+// Pure cancellation stays cancellation; only unknown-capability deadlines are
+// unconfirmed. A cancellation after this final observation is inherently concurrent.
+func (s *Stream) classifyConnectExit(ctx context.Context, result error) error {
+	if err := ctx.Err(); err != nil {
+		result = err
+	}
+	if !s.sess.peerSettingsKnown.Load() && (errors.Is(result, context.DeadlineExceeded) || errors.Is(result, os.ErrDeadlineExceeded)) {
+		return errors.Join(ErrConnectACKUnconfirmed, result)
+	}
+	return result
+}
+
+// WaitConnect waits for this stream's remote TCP CONNECT report, not target TLS.
+// Call ONLY after successfully writing the target address, before business data.
+// It never retries, writes payload, closes a stream or resets a session. The owner
+// must close losing/failed streams. Cancellation affects only that waiter.
+// Each call has a local 3s budget; reuse the caller's total dial deadline.
+func (s *Stream) WaitConnect(ctx context.Context) (result error) {
+	defer func() { result = s.classifyConnectExit(ctx, result) }()
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	timer := time.NewTimer(3 * time.Second)
+	defer timer.Stop()
+	capability := s.sess.peerSettings
+	for {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		select {
+		case <-s.connectDone:
+			return s.connectErr
+		default:
+		}
+		if s.sess.peerSettingsKnown.Load() && s.sess.peerVersion.Load() < 2 {
+			return ErrConnectACKUnsupported
+		}
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-s.connectDeadline.Wait():
+			return os.ErrDeadlineExceeded
+		case <-timer.C:
+			return os.ErrDeadlineExceeded
+		case <-capability:
+			capability = nil
+		case <-s.connectDone:
+			return s.connectErr
+		}
+	}
+}
