+// NewStreamDNSConn transfers route replay buffers before asynchronous DNS
+// callbacks can close their CachedConn owner. Only the finite memory reads are
+// locked; closing the upstream must always be able to wake a network read.
+func NewStreamDNSConn(conn net.Conn) net.Conn {
+	if _, ok := conn.(*streamDNSConn); ok {
+		return conn
+	}
+	reader := conn
+	var buffers []*buf.Buffer
+	for {
+		cached, ok := reader.(*bufio.CachedConn)
+		if !ok {
+			break
+		}
+		if buffer := cached.ReadCached(); buffer != nil {
+			buffers = append(buffers, buffer)
+		}
+		reader = cached.Conn
+	}
+	return &streamDNSConn{Conn: conn, reader: reader, buffers: buffers}
+}
+
+type streamDNSConn struct {
+	net.Conn
+	reader   net.Conn
+	access   sync.Mutex
+	buffers  []*buf.Buffer
+	closed   bool
+	once     sync.Once
+	closeErr error
+}
+
+func (c *streamDNSConn) Read(p []byte) (int, error) {
+	c.access.Lock()
+	if c.closed {
+		c.access.Unlock()
+		return 0, net.ErrClosed
+	}
+	for len(c.buffers) > 0 {
+		buffer := c.buffers[0]
+		if !buffer.IsEmpty() {
+			n, err := buffer.Read(p)
+			c.access.Unlock()
+			return n, err
+		}
+		c.buffers = c.buffers[1:]
+		buffer.Release()
+	}
+	c.access.Unlock()
+	return c.reader.Read(p)
+}
+
+func (c *streamDNSConn) Close() error {
+	c.once.Do(func() {
+		c.closeErr = c.Conn.Close()
+		c.access.Lock()
+		c.closed = true
+		for _, buffer := range c.buffers {
+			buffer.Release()
+		}
+		c.buffers = nil
+		c.access.Unlock()
+	})
+	return c.closeErr
+}
+
+func (c *streamDNSConn) Upstream() any {
+	return c.Conn
+}
